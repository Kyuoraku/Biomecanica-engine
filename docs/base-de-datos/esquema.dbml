// Biomecánica Lab · esquema propuesto (v2) — PARA REVISAR, no implementado
// Pegá el contenido en https://dbdiagram.io/d

Project biomecanica_lab {
  database_type: 'PostgreSQL'
  Note: 'Propuesta para la v2 (cuentas, alumnos y links). Pendiente de D-04, D-06 y D-09.'
}

// Enums --------------------------------------------------------------------

Enum camera_view {
  lateral
  frontal
  posterior
  superior
  three_quarter [note: 'Vista 3/4']
}

Enum scene_layer {
  bones [note: 'Solo huesos']
  muscles [note: 'Huesos y todos los músculos']
  active [note: 'Solo músculos activos']
}

// Cuentas ------------------------------------------------------------------

Table trainer {
  id uuid [pk, note: 'Igual a auth.users.id']
  display_name text [not null]
  created_at timestamptz [not null, default: `now()`]
  Note: 'Perfil del entrenador, 1 a 1 con auth.users'
}

// Alumnos ------------------------------------------------------------------

Table athlete {
  id uuid [pk, default: `gen_random_uuid()`]
  trainer_id uuid [not null, ref: > trainer.id]
  name text [not null]
  notes text
  created_at timestamptz [not null, default: `now()`]
  Note: 'Alumno de un entrenador'
}

Table body_profile {
  id uuid [pk, default: `gen_random_uuid()`]
  trainer_id uuid [not null, ref: > trainer.id]
  athlete_id uuid [ref: > athlete.id, note: 'Nulo = plantilla propia del entrenador. Se borra con el alumno']
  name text [not null]
  height_cm smallint [not null, note: 'Check 145–205']
  femur_pct numeric(4,1) [not null, note: '% de la altura. Check 19–30']
  tibia_pct numeric(4,1) [not null, note: 'Check 20–29']
  torso_pct numeric(4,1) [not null, note: 'Cadera → hombro. Check 23–34']
  arm_pct numeric(4,1) [not null, note: 'Check 15–22']
  ankle_dorsiflexion_deg smallint [not null, note: 'Check 5–50']
  hip_flexion_deg smallint [not null, note: 'Check 85–140']
  hamstring_limit_deg smallint [not null, note: 'Flexión de cadera con rodilla extendida. Check 45–115']
  pelvic_tilt_deg smallint [not null, note: 'Inclinación en reposo, + = anteversión. Check −12–22']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Filtros anatómicos guardados con nombre'
}

// Contenido ----------------------------------------------------------------

Table exercise {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_id uuid [ref: > trainer.id, note: 'Nulo = ejercicio del sistema, no editable']
  slug text [not null, note: 'Único por dueño']
  name text [not null]
  definition jsonb [not null, note: 'Formato de D-10: solver, recorrido, carga, cámara, textos, músculos']
  engine_version text [not null, note: 'Versión del motor con la que se definió']
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (owner_id, slug) [unique]
  }
}

// Compartir ----------------------------------------------------------------

Table shared_scene {
  id uuid [pk, default: `gen_random_uuid()`]
  public_code text [not null, unique, note: '8 letras o números; va en el link']
  trainer_id uuid [not null, ref: > trainer.id]
  athlete_id uuid [ref: > athlete.id, note: 'Opcional. Queda en nulo si se borra el alumno']
  exercise_id uuid [not null, ref: > exercise.id]
  model_a jsonb [not null, note: 'Copia de los filtros al guardar (no referencia), para que la escena no cambie si se edita el perfil']
  model_b jsonb
  progress numeric(4,3) [not null, note: 'Instante 0–1']
  exercise_range smallint [not null]
  load_pct smallint [not null, default: 0]
  camera camera_view [not null, default: 'lateral']
  layer scene_layer [not null, default: 'bones']
  options jsonb [not null, default: '{}', note: 'Toggles de vista']
  engine_version text [not null]
  expires_at timestamptz [note: 'Opcional']
  created_at timestamptz [not null, default: `now()`]
  Note: 'Escena guardada para compartir por link'
}
